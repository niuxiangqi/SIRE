# --- model weights / checkpoints (never commit) ---
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
models/
checkpoints/

# --- datasets and raw inputs (never commit) ---
data/raw/
data/datasets/
*.parquet
*.arrow

# --- large derived feature arrays (regenerated by collect-features) ---
*.npy
*.npz
runs/*/features/*
!runs/*/features/meta.json
runs/*/features/accum_partial.pt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- notebooks / editors / OS ---
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# --- logs, secrets, experiment trackers ---
*.log
.env
.env.*
wandb/
mlruns/

# --- temporary / scratch ---
*.tmp
*.swp
